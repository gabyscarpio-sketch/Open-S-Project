---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Administración - OpenS">
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 py-10">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900">Panel de Administración</h1>
      <p class="text-slate-500 mt-2">Configuración del motor de IA y estado del sistema.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- AI Model Config -->
      <div class="col-span-full lg:col-span-2 p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="text-lg font-bold text-slate-800 mb-4">Configuración del Motor de IA</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="cursor-pointer group">
            <input type="radio" name="ai-engine" value="gemini" checked class="peer sr-only" />
            <div class="p-5 rounded-xl border-2 border-slate-200 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 transition-all group-hover:border-indigo-300">
              <div class="flex items-center gap-3 mb-2">
                <span id="gemini-dot" class="w-3 h-3 rounded-full bg-slate-300"></span>
                <span class="font-bold text-slate-800">Google Gemini 2.5 Flash</span>
              </div>
              <p class="text-sm text-slate-500">Motor Cloud. Requiere internet.</p>
            </div>
          </label>
          <label class="cursor-pointer group">
            <input type="radio" name="ai-engine" value="qwen" class="peer sr-only" />
            <div class="p-5 rounded-xl border-2 border-slate-200 peer-checked:border-indigo-500 peer-checked:bg-indigo-50 transition-all group-hover:border-indigo-300">
              <div class="flex items-center gap-3 mb-2">
                <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                <span class="font-bold text-slate-800">Qwen (Local / Ollama)</span>
              </div>
              <p class="text-sm text-slate-500">Motor Local. Sin internet. Privacidad total.</p>
            </div>
          </label>
        </div>
      </div>

      <!-- System status -->
      <div class="p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="text-lg font-bold text-slate-800 mb-4">Estado del Sistema</h2>
        <div id="system-status" class="space-y-3">
          <p class="text-sm text-slate-400">Cargando...</p>
        </div>
      </div>

      <!-- Patients count -->
      <div class="col-span-full lg:col-span-2 p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="text-lg font-bold text-slate-800 mb-4">Datos en Supabase</h2>
        <div id="admin-data" class="text-sm text-slate-400">Cargando...</div>
      </div>

      <!-- Local models -->
      <div class="col-span-full p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="text-lg font-bold text-slate-800 mb-4">Modelos Locales (Ollama)</h2>
        <div id="local-models" class="text-sm text-slate-400">Cargando...</div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const API = '/api/v1';

  async function apiFetch(path: string) {
    try { const r = await fetch(path); if (r.ok) return await r.json(); } catch {}
    try { const r = await fetch(`http://localhost:8001${path}`); if (r.ok) return await r.json(); } catch {}
    return null;
  }

  (async () => {
    // System health
    const health = await apiFetch('/health');
    const statusEl = document.getElementById('system-status')!;
    if (health) {
      const geminiOk = health.google_ai_configured;
      const supaOk = health.supabase_configured;
      document.getElementById('gemini-dot')!.className = `w-3 h-3 rounded-full ${geminiOk ? 'bg-green-500' : 'bg-red-400'}`;
      statusEl.innerHTML = `
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <span class="text-slate-700">Gemini</span>
          <span class="text-xs font-semibold ${geminiOk ? 'text-green-600' : 'text-red-500'}">${geminiOk ? 'Conectado' : 'No configurado'}</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <span class="text-slate-700">Supabase</span>
          <span class="text-xs font-semibold ${supaOk ? 'text-green-600' : 'text-red-500'}">${supaOk ? 'Conectado' : 'No configurado'}</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <span class="text-slate-700">Modelo</span>
          <span class="text-xs font-semibold text-slate-600">${health.model || 'N/A'}</span>
        </div>`;
    } else {
      statusEl.innerHTML = '<p class="text-sm text-red-500">No se pudo conectar al backend.</p>';
    }

    // Patients count
    const data = await apiFetch(`${API}/patients`);
    const patients = data?.patients || [];
    document.getElementById('admin-data')!.innerHTML = `
      <p class="text-slate-700"><strong>${patients.length}</strong> pacientes registrados en la base de datos.</p>
      ${patients.length > 0 ? '<p class="text-xs text-slate-400 mt-1">Los datos se cargan en tiempo real desde Supabase.</p>' : '<p class="text-xs text-slate-400 mt-1">Ejecute supabase_schema.sql y agregue pacientes.</p>'}
    `;

    // Local models
    const models = await apiFetch(`${API}/local-models`);
    const modelsEl = document.getElementById('local-models')!;
    if (models) {
      const chain = models.configured_chain || [];
      const ready = models.ready || [];
      const missing = models.missing || [];
      modelsEl.innerHTML = `
        <p class="text-xs text-slate-500 mb-3">Cadena de fallback — el sistema prueba cada modelo en orden hasta que uno responda.</p>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
          ${chain.map((m: string, i: number) => {
            const isReady = ready.includes(m);
            return `<div class="flex items-center gap-2 p-2.5 rounded-lg ${isReady ? 'bg-emerald-50 border border-emerald-200' : 'bg-slate-50 border border-slate-200'}">
              <span class="text-xs font-bold text-slate-400 w-4">${i + 1}</span>
              <span class="w-2 h-2 rounded-full ${isReady ? 'bg-emerald-500' : 'bg-slate-300'}"></span>
              <span class="text-sm font-medium ${isReady ? 'text-emerald-700' : 'text-slate-500'}">${m}</span>
            </div>`;
          }).join('')}
        </div>
        <p class="text-xs text-slate-400 mt-3">
          <strong class="text-emerald-600">${ready.length}</strong> listos · 
          <strong class="text-slate-500">${missing.length}</strong> por instalar · 
          Ollama: <code class="bg-slate-100 px-1 rounded">${models.ollama_url}</code>
        </p>
        ${missing.length > 0 ? `<p class="text-xs text-slate-400 mt-1">Instalar modelos faltantes: <code class="bg-slate-100 px-1 rounded">ollama pull ${missing[0]}</code></p>` : ''}
      `;
    } else {
      modelsEl.innerHTML = '<p class="text-sm text-red-500">No se pudo conectar con Ollama.</p>';
    }
  })();
</script>
