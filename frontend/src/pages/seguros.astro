---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Seguros - OpenS">
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900">Gestión de Seguros</h1>
      <p class="text-slate-500 mt-2">Validación de coberturas y convenios institucionales.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">🏥</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">Seguros Horizonte</h3>
            <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full font-medium">Activo</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Cobertura general, emergencias y hospitalización.</p>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">💊</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">MedSalud Plus</h3>
            <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full font-medium">Activo</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Plan premium con consultas ilimitadas y farmacia.</p>
      </div>

      <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-lg hover:shadow-indigo-50 transition-all group">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-2xl">🩺</span>
          </div>
          <div>
            <h3 class="font-bold text-slate-800">SeguroVida</h3>
            <span class="text-xs px-2 py-0.5 bg-amber-100 text-amber-700 rounded-full font-medium">Pendiente</span>
          </div>
        </div>
        <p class="text-sm text-slate-500">Convenio en revisión para ambulatorios públicos.</p>
      </div>
    </div>
  </main>
</BaseLayout>
