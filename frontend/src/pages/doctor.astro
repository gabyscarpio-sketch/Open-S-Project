---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Dashboard Médico - OpenS">
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900">Dashboard Médico</h1>
      <p class="text-slate-500 mt-2">Pacientes registrados en el sistema y accesos rápidos.</p>
    </div>

    <!-- Stats from Supabase -->
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <div class="p-5 rounded-2xl bg-gradient-to-br from-indigo-500 to-blue-500 text-white">
        <p class="text-sm text-indigo-100">Pacientes Registrados</p>
        <p id="stat-patients" class="text-4xl font-extrabold mt-1">—</p>
      </div>
      <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 text-white">
        <p class="text-sm text-emerald-100">Registros Médicos</p>
        <p id="stat-records" class="text-4xl font-extrabold mt-1">—</p>
      </div>
      <div class="p-5 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-500 text-white">
        <p class="text-sm text-amber-100">Motor IA Activo</p>
        <p id="stat-ai" class="text-4xl font-extrabold mt-1">—</p>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <!-- Patient list from Supabase -->
      <div class="p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="font-bold text-slate-800 mb-4">Pacientes en Supabase</h2>
        <div id="doctor-patients" class="space-y-3">
          <p class="text-sm text-slate-400 text-center py-4">Cargando...</p>
        </div>
      </div>

      <!-- Quick actions -->
      <div class="p-6 rounded-2xl border border-slate-200 bg-white">
        <h2 class="font-bold text-slate-800 mb-4">Acciones Rápidas</h2>
        <div class="space-y-3">
          <a href="/asistente" class="flex items-center gap-4 p-3 bg-indigo-50 rounded-xl hover:bg-indigo-100 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-indigo-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            </div>
            <div><p class="font-medium text-slate-800">Abrir Asistente IA</p><p class="text-xs text-slate-500">Consultar historial con inteligencia artificial</p></div>
          </a>
          <a href="/paciente" class="flex items-center gap-4 p-3 bg-emerald-50 rounded-xl hover:bg-emerald-100 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-emerald-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div><p class="font-medium text-slate-800">Portal del Paciente</p><p class="text-xs text-slate-500">Ver perfil y datos del paciente</p></div>
          </a>
          <a href="/admin" class="flex items-center gap-4 p-3 bg-amber-50 rounded-xl hover:bg-amber-100 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-amber-600 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div><p class="font-medium text-slate-800">Administración</p><p class="text-xs text-slate-500">Configurar motor de IA y sedes</p></div>
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const API = '/api/v1';

  async function apiFetch(path: string) {
    try {
      const res = await fetch(path);
      if (res.ok) return await res.json();
    } catch {}
    try {
      const res = await fetch(`http://localhost:8001${path}`);
      if (res.ok) return await res.json();
    } catch {}
    return null;
  }

  // Load patients
  (async () => {
    const data = await apiFetch(`${API}/patients`);
    const patients = data?.patients || [];
    const container = document.getElementById('doctor-patients')!;
    const statEl = document.getElementById('stat-patients')!;
    statEl.textContent = String(patients.length);

    if (patients.length === 0) {
      container.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">No hay pacientes registrados en Supabase.</p>';
    } else {
      container.innerHTML = patients.map((p: any) =>
        `<div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
          <div>
            <p class="font-medium text-slate-800">${p.name || 'Sin nombre'}</p>
            <p class="text-xs text-slate-500">${p.phone || p.email || 'ID: ' + p.id}</p>
          </div>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
        </div>`
      ).join('');
    }

    // Health check for AI status
    const health = await apiFetch('/health');
    const aiEl = document.getElementById('stat-ai')!;
    if (health?.google_ai_configured) {
      aiEl.textContent = 'Gemini';
    } else {
      aiEl.textContent = 'Ollama';
    }

    document.getElementById('stat-records')!.textContent = '—';
  })();
</script>
