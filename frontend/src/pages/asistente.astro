---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout title="Asistente IA - OpenS">
  <Navbar />
  <main class="max-w-7xl mx-auto px-4 py-6">
    <!-- Search Bar -->
    <div class="relative mb-6" id="search-container">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input id="patient-search" type="text" placeholder="Buscar paciente por nombre..." class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-slate-200 bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none text-slate-800 shadow-sm"/>
      </div>
      <div id="search-results" class="hidden absolute z-20 w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl max-h-64 overflow-y-auto"></div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      <!-- Chat Panel -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
          <div class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white p-5 flex items-center justify-between">
            <div>
              <h2 class="text-xl font-bold">Chat con Asistente</h2>
              <p id="patient-label" class="text-sm text-indigo-200 mt-0.5">Selecciona un paciente para comenzar</p>
            </div>
            <div id="ai-badge" class="px-3 py-1 rounded-full bg-white/20 text-xs font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-green-400"></span>Gemini Cloud
            </div>
          </div>

          <div id="chat-messages" class="h-[420px] overflow-y-auto p-6 space-y-4 bg-slate-50 chat-scroll">
            <div id="chat-placeholder" class="text-center text-slate-400 mt-32">
              <svg class="mx-auto h-14 w-14 text-indigo-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
              <p class="font-semibold text-slate-600">Bienvenido a OpenS</p>
              <p class="text-sm mt-1">Selecciona un paciente y pregunta sobre su historial</p>
            </div>
          </div>

          <!-- Suggested Questions -->
          <div id="suggestions" class="px-5 py-3 border-t border-slate-100 bg-white">
            <p class="text-xs font-medium text-slate-400 mb-2">Preguntas sugeridas:</p>
            <div class="flex flex-wrap gap-2">
              <button class="suggestion-btn px-3 py-1.5 text-xs rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition-colors">¿Qué patología tiene el paciente?</button>
              <button class="suggestion-btn px-3 py-1.5 text-xs rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition-colors">Resumen del historial médico</button>
              <button class="suggestion-btn px-3 py-1.5 text-xs rounded-full bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition-colors">¿Qué medicación lleva actualmente?</button>
            </div>
          </div>

          <form id="chat-form" class="border-t border-slate-200 p-4 bg-white flex gap-3">
            <input id="chat-input" type="text" placeholder="Escribe tu pregunta aquí..." class="flex-1 px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none text-slate-800"/>
            <button type="submit" id="send-btn" class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-xl font-semibold shadow-md shadow-indigo-200 hover:shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">Enviar</button>
          </form>
        </div>

        <!-- Voice Button -->
        <button id="voice-btn" class="mt-4 w-full py-3 bg-white border border-slate-200 rounded-2xl text-slate-600 font-semibold hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-600 transition-all flex items-center justify-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
          Escuchar última respuesta (ElevenLabs)
        </button>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Patients from Supabase -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-white">
          <h3 class="font-bold text-slate-800 mb-3">Pacientes</h3>
          <div id="patients-list" class="space-y-2">
            <p class="text-sm text-slate-400 text-center py-4">Cargando pacientes...</p>
          </div>
        </div>

        <!-- Medical records from Supabase -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-white">
          <h3 class="font-bold text-slate-800 mb-4">Historial Médico</h3>
          <div id="records-list" class="relative pl-6 space-y-5 before:absolute before:left-2 before:top-1 before:bottom-1 before:w-0.5 before:bg-indigo-200">
            <p class="text-sm text-slate-400 text-center py-4 pl-0">Selecciona un paciente</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col items-end gap-2"></div>
  <audio id="voice-audio" class="hidden"></audio>
</BaseLayout>

<script>
  // --- State ---
  let currentPatient: {id: number; name: string} | null = null;
  let lastResponse = '';
  let isLoading = false;

  const API = '/api/v1';

  // --- DOM ---
  const chatMessages = document.getElementById('chat-messages')!;
  const chatForm = document.getElementById('chat-form')!;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('send-btn')!;
  const patientLabel = document.getElementById('patient-label')!;
  const voiceBtn = document.getElementById('voice-btn')!;
  const suggestions = document.getElementById('suggestions')!;
  const toastContainer = document.getElementById('toast-container')!;
  const voiceAudio = document.getElementById('voice-audio') as HTMLAudioElement;
  const patientsList = document.getElementById('patients-list')!;
  const recordsList = document.getElementById('records-list')!;

  // --- Helpers ---
  function showToast(msg: string, type: 'success'|'error'|'info' = 'info') {
    const colors = { success: 'bg-emerald-500', error: 'bg-red-500', info: 'bg-indigo-500' };
    const el = document.createElement('div');
    el.className = `${colors[type]} text-white px-5 py-3 rounded-xl shadow-lg text-sm font-medium animate-slide-in`;
    el.textContent = msg;
    toastContainer.appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity 0.3s'; setTimeout(() => el.remove(), 300); }, 3000);
  }

  function initials(name: string) {
    return name.split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2);
  }

  async function apiFetch(path: string, fallbackPath?: string) {
    try {
      const res = await fetch(path);
      if (res.ok) return await res.json();
    } catch {}
    if (fallbackPath) {
      try {
        const res = await fetch(fallbackPath);
        if (res.ok) return await res.json();
      } catch {}
    }
    return null;
  }

  // --- Load patients from Supabase ---
  async function loadPatients() {
    const data = await apiFetch(`${API}/patients`, `http://localhost:8001${API}/patients`);
    const patients = data?.patients || [];
    if (patients.length === 0) {
      patientsList.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">No hay pacientes registrados en Supabase.</p>';
      return;
    }
    const colors = ['indigo', 'emerald', 'amber', 'blue', 'purple'];
    patientsList.innerHTML = patients.map((p: any, i: number) => {
      const c = colors[i % colors.length];
      const name = p.name || 'Sin nombre';
      return `<button class="patient-card w-full text-left p-3 rounded-xl hover:bg-indigo-50 transition-colors" data-id="${p.id}" data-name="${name}">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-${c}-100 flex items-center justify-center text-sm font-bold text-${c}-600">${initials(name)}</div>
          <div>
            <p class="text-sm font-medium text-slate-800">${name}</p>
            <p class="text-xs text-slate-400">${p.phone || p.email || 'ID: ' + p.id}</p>
          </div>
        </div>
      </button>`;
    }).join('');

    // Bind click handlers
    patientsList.querySelectorAll('.patient-card').forEach(card => {
      card.addEventListener('click', () => selectPatient(
        Number((card as HTMLElement).dataset.id),
        (card as HTMLElement).dataset.name || ''
      ));
    });
  }

  // --- Select patient and load records ---
  async function selectPatient(id: number, name: string) {
    currentPatient = { id, name };
    patientLabel.textContent = `Paciente: ${name} (ID: ${id})`;
    showToast(`Paciente: ${name}`, 'info');
    loadRecords(id);
  }

  async function loadRecords(patientId: number) {
    recordsList.innerHTML = '<p class="text-sm text-slate-400 text-center py-4 pl-0">Cargando historial...</p>';
    const data = await apiFetch(`${API}/patients/${patientId}/records`, `http://localhost:8001${API}/patients/${patientId}/records`);
    const records = data?.records || [];
    if (records.length === 0) {
      recordsList.innerHTML = '<p class="text-sm text-slate-400 text-center py-4 pl-0">Sin registros médicos para este paciente.</p>';
      return;
    }
    const icons: Record<string, string> = { cardiology: '❤', lab: '🧪', prescription: '💊' };
    const bgColors: Record<string, string> = { cardiology: 'bg-red-100', lab: 'bg-purple-100', prescription: 'bg-blue-100' };
    recordsList.innerHTML = records.map((r: any) => {
      const type = r.type || 'general';
      const icon = icons[type] || '📋';
      const bg = bgColors[type] || 'bg-slate-100';
      const date = r.date || r.created_at || '';
      const shortDate = date ? new Date(date).toLocaleDateString('es', { month: 'short', day: 'numeric' }) : '';
      const title = r.description || r.diagnosis || 'Registro';
      return `<div class="relative">
        <div class="absolute -left-6 w-5 h-5 rounded-full ${bg} border-2 border-white shadow flex items-center justify-center"><span class="text-[10px]">${icon}</span></div>
        <p class="text-xs font-semibold text-indigo-600">${shortDate}</p>
        <p class="text-sm font-medium text-slate-800">${title}</p>
        ${r.diagnosis ? `<p class="text-xs text-slate-500">${r.diagnosis}</p>` : ''}
      </div>`;
    }).join('');
  }

  // --- Search patients from Supabase ---
  const searchInput = document.getElementById('patient-search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;
  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    const q = searchInput.value.trim();
    if (!q) { searchResults.classList.add('hidden'); return; }
    searchTimeout = setTimeout(async () => {
      const data = await apiFetch(`${API}/patients?q=${encodeURIComponent(q)}`, `http://localhost:8001${API}/patients?q=${encodeURIComponent(q)}`);
      const patients = data?.patients || [];
      if (patients.length === 0) {
        searchResults.innerHTML = '<p class="p-4 text-sm text-slate-500 text-center">No encontrado</p>';
      } else {
        searchResults.innerHTML = patients.map((p: any) =>
          `<button class="w-full text-left px-4 py-3 hover:bg-indigo-50 transition-colors border-b last:border-b-0" data-sid="${p.id}" data-sname="${p.name || 'Sin nombre'}">
            <p class="font-medium text-slate-800">${p.name || 'Sin nombre'}</p>
            <p class="text-xs text-slate-500">${p.phone || p.email || 'ID: ' + p.id}</p>
          </button>`
        ).join('');
        searchResults.querySelectorAll('button').forEach(btn => {
          btn.addEventListener('click', () => {
            selectPatient(Number((btn as HTMLElement).dataset.sid), (btn as HTMLElement).dataset.sname || '');
            searchInput.value = '';
            searchResults.classList.add('hidden');
          });
        });
      }
      searchResults.classList.remove('hidden');
    }, 300);
  });

  // --- Suggestions ---
  document.querySelectorAll('.suggestion-btn').forEach(btn => {
    btn.addEventListener('click', () => { chatInput.value = btn.textContent || ''; chatInput.focus(); });
  });

  // --- Add message to DOM ---
  function addMessage(role: 'user'|'assistant', content: string) {
    document.getElementById('chat-placeholder')?.remove();
    const isUser = role === 'user';
    const wrapper = document.createElement('div');
    wrapper.className = `flex ${isUser ? 'justify-end' : 'justify-start'} animate-fade-in`;
    const bubble = document.createElement('div');
    bubble.className = `max-w-sm md:max-w-md lg:max-w-lg px-4 py-3 rounded-2xl text-sm leading-relaxed ${
      isUser ? 'bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-br-md' : 'bg-white text-slate-800 shadow-md border border-slate-100 rounded-bl-md'
    }`;
    bubble.innerHTML = content.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br/>');
    wrapper.appendChild(bubble);
    chatMessages.appendChild(wrapper);
    chatMessages.scrollTop = chatMessages.scrollHeight;
    return bubble;
  }

  function addTypingIndicator() {
    const wrapper = document.createElement('div');
    wrapper.className = 'flex justify-start';
    wrapper.id = 'typing-indicator';
    wrapper.innerHTML = '<div class="bg-white px-5 py-3 rounded-2xl rounded-bl-md shadow-md border border-slate-100"><div class="flex gap-1.5"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div></div>';
    chatMessages.appendChild(wrapper);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function removeTypingIndicator() { document.getElementById('typing-indicator')?.remove(); }

  function streamText(text: string, el: HTMLElement) {
    const words = text.split(' ');
    let i = 0;
    const interval = setInterval(() => {
      if (i < words.length) {
        el.innerHTML = words.slice(0, i + 1).join(' ').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br/>');
        chatMessages.scrollTop = chatMessages.scrollHeight;
        i++;
      } else clearInterval(interval);
    }, 40);
  }

  // --- Send message ---
  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = chatInput.value.trim();
    if (!text || isLoading) return;
    if (!currentPatient) { showToast('Selecciona un paciente primero', 'info'); return; }

    addMessage('user', text);
    chatInput.value = '';
    isLoading = true;
    sendBtn.setAttribute('disabled', '');
    suggestions.classList.add('hidden');
    addTypingIndicator();

    try {
      let res: Response;
      const body = JSON.stringify({ patient_id: currentPatient.id, prompt_text: text });
      const headers = { 'Content-Type': 'application/json' };
      try {
        res = await fetch(`${API}/assistant/ask`, { method: 'POST', headers, body });
      } catch {
        res = await fetch(`http://localhost:8001${API}/assistant/ask`, { method: 'POST', headers, body });
      }
      if (!res.ok) throw new Error('Error del servidor');
      const data = await res.json();
      removeTypingIndicator();
      lastResponse = data.response;
      const bubble = addMessage('assistant', '');
      streamText(data.response, bubble);
      showToast('Respuesta recibida', 'success');
    } catch {
      removeTypingIndicator();
      addMessage('assistant', 'Error de conexión. Verifica que el servidor esté activo.');
      showToast('Error al conectar', 'error');
    } finally {
      isLoading = false;
      sendBtn.removeAttribute('disabled');
    }
  });

  // --- Voice ---
  voiceBtn.addEventListener('click', async () => {
    if (!lastResponse) { showToast('No hay respuesta para reproducir', 'info'); return; }
    voiceBtn.textContent = '⏳ Generando audio...';
    try {
      const res = await fetch(`${API}/voice/generate`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: lastResponse }),
      });
      if (!res.ok) throw new Error('Error');
      const blob = await res.blob();
      voiceAudio.src = URL.createObjectURL(blob);
      voiceAudio.play();
      showToast('Reproduciendo audio', 'success');
    } catch {
      showToast('Error al generar audio', 'error');
    } finally {
      voiceBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg> Escuchar última respuesta (ElevenLabs)';
    }
  });

  // --- Init: load patients from Supabase ---
  loadPatients();
</script>
