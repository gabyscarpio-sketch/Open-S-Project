# ═══════════════════════════════════════════
# OpenS — Resilience Edition
# Copia este archivo como .env y rellena los valores
# ═══════════════════════════════════════════

# GOOGLE GEMINI (Motor Cloud — obligatorio para IA en la nube)
# Obtener en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ═══════════════════════════════════════════
# OLLAMA (Modelos Locales — fallback automático)
# ═══════════════════════════════════════════
# Instalar desde: https://ollama.com
#
# URL base de Ollama (sin /api/generate)
OLLAMA_BASE_URL=http://localhost:11434
#
# Cadena de modelos a intentar en orden (fallback chain).
# El sistema prueba cada modelo en secuencia hasta que uno responda.
# Modelos soportados:
#   - qwen2.5:7b     → Alibaba Qwen 2.5 (recomendado para español)
#   - kimi-k2        → Moonshot Kimi K2
#   - llama3.2:3b    → Meta Llama 3.2 (ligero, 3B params)
#   - mistral        → Mistral 7B
#   - deepseek-r1:7b → DeepSeek R1
#   - phi4-mini      → Microsoft Phi-4 Mini
#   - gemma3:4b      → Google Gemma 3 (4B params)
#   - codegemma      → Google CodeGemma (para código)
#   - llama3.1:8b    → Meta Llama 3.1 (8B params)
#   - qwen2.5:14b    → Alibaba Qwen 2.5 (14B, más potente)
#   - mistral-small  → Mistral Small 22B
#
# Instalar modelos con: ollama pull <nombre>
OLLAMA_MODELS=qwen2.5:7b,kimi-k2,llama3.2:3b,mistral,deepseek-r1:7b,phi4-mini,gemma3:4b

# ═══════════════════════════════════════════
# SUPABASE (Base de datos)
# ═══════════════════════════════════════════
# Obtener en: https://app.supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_KEY=

# ═══════════════════════════════════════════
# ELEVENLABS (Voz — opcional)
# ═══════════════════════════════════════════
# Obtener en: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM